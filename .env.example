# ==============================================================================
# VectorDB Configuration (HERMES v6 Standard)
# ==============================================================================

# -- Server Configuration --
VDB_HOST=0.0.0.0
VDB_PORT=8000
VDB_RELOAD=false

# -- Storage & Data Paths --
VDB_DATA_DIR=data

# -- Vector & Index Settings --
VDB_DIMENSION=384
VDB_AUTO_SAVE=100
VDB_AUTO_SCALE=true
VDB_FLAT_THRESHOLD=10000
VDB_HNSW_THRESHOLD=100000
VDB_IVF_NLIST=100
VDB_IVF_NPROBE=10
VDB_HNSW_M=32
VDB_HNSW_EF=64
VDB_HNSW_EF_SEARCH=64
VDB_REBUILD_RATIO=0.3

# -- Authentication & Security --
VDB_ADMIN_KEY=admin-secret
VDB_USER_KEYS=user-secret,demo-key-1,demo-key-2

# -- Rate Limiting --
VDB_RATE_LIMIT=true
VDB_RATE_LIMIT_RPM=1000

# -- Query Cache --
VDB_CACHE=true
VDB_CACHE_SIZE=1024
VDB_CACHE_TTL=60.0

# -- Embeddings & Reranking --
VDB_EMBEDDING_MODEL=all-MiniLM-L6-v2
VDB_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
VDB_RERANKER=false

# -- Background Tasks & Maintenance --
VDB_REAPER_INTERVAL=60
VDB_AUTOSAVE_SEC=300

# -- Observability & Logging --
VDB_LOG_LEVEL=INFO
VDB_LOG_FORMAT=text
VDB_SLOW_QUERY_MS=100.0
